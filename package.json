{
  "name": "iframe-msg-promise",
  "version": "2.0.0",
  "description": "Promise-based request/response messaging between windows and cross-domain iframes, over postMessage.",
  "keywords": [
    "iframe",
    "postmessage",
    "promise",
    "cross-domain",
    "cross-origin",
    "messaging",
    "rpc",
    "window",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/types/react/index.d.ts"
      ]
    }
  },
  "unpkg": "./dist/index.umd.cjs",
  "jsdelivr": "./dist/index.umd.cjs",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "author": "Andy Pi",
  "homepage": "https://github.com/three-fourteen/iframe-msg-promise#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/three-fourteen/iframe-msg-promise"
  },
  "bugs": {
    "url": "https://github.com/three-fourteen/iframe-msg-promise/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.react.config.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^13.4.0",
    "@types/node": "^18.7.18",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "^2.1.0",
    "jsdom": "^22.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.6.4",
    "vite": "^3.1.0",
    "vitest": "^0.34.6"
  }
}
