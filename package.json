{
  "name": "iframe-msg-promise",
  "version": "2.0.0",
  "description": "Promise-based request/response messaging between windows and cross-domain iframes, over postMessage.",
  "keywords": [
    "iframe",
    "postmessage",
    "promise",
    "cross-domain",
    "cross-origin",
    "messaging",
    "rpc",
    "window",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/types/react/index.d.ts"
      ]
    }
  },
  "unpkg": "./dist/index.umd.cjs",
  "jsdelivr": "./dist/index.umd.cjs",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "author": "Andy Pi",
  "homepage": "https://github.com/three-fourteen/iframe-msg-promise#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/three-fourteen/iframe-msg-promise.git"
  },
  "bugs": {
    "url": "https://github.com/three-fourteen/iframe-msg-promise/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.umd.config.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check-pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "yarn test && yarn build && yarn check-pack"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
